# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Use a read-only key, not the board's upload key.

# AWS (shared by all aws_* tools)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Video frames (aws_download_kvs_frames): needs kinesisvideo:GetDataEndpoint and kinesisvideo:GetImages
KVS_STREAM_NAME=kvs_example_camera_stream

# Frame analysis (aws_analyze_kvs_frames): set at least one key. Anthropic is used if both are set.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional overrides:
# VISION_PROVIDER=anthropic   # or gemini
# ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
# GEMINI_VISION_MODEL=gemini-2.5-flash
