# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# Use a read-only key, not the board's upload key.

# AWS (shared by all aws_* tools)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Video frames (aws_fetch_kvs_frames): needs kinesisvideo:GetDataEndpoint and kinesisvideo:GetImages
KVS_STREAM_NAME=kvs_example_camera_stream
